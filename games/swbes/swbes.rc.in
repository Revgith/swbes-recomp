// Generated into the build folder by CMake (version from VERSION).
#include <winver.h>
@SWBES_ICON_LINE@
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SWBES_VERSION_COMMAS@,0
 PRODUCTVERSION @SWBES_VERSION_COMMAS@,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "swbes-recomp (unofficial PC port)"
      VALUE "ProductName", "swbes-recomp"
      VALUE "FileVersion", "@SWBES_VERSION@"
      VALUE "ProductVersion", "@SWBES_VERSION@"
      VALUE "OriginalFilename", "swbes.exe"
      VALUE "LegalCopyright", "Unofficial fan project; see LICENSE"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
